# Configuración de MS2 - Motor de Ejecución y Evaluación

# Información de la aplicación
APP_NAME="MS2 - Motor de Ejecución y Evaluación"
APP_VERSION="1.0.0"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000

# Base de datos PostgreSQL
# En desarrollo local: localhost
# En Docker Compose: postgres (nombre del servicio)
DATABASE_URL="postgresql://runner_user:runner_pass@localhost:5432/db_code_runner"

# Configuración del sandbox
SANDBOX_MAX_TIMEOUT_MS=10000
SANDBOX_MAX_MEMORY_KB=65536
