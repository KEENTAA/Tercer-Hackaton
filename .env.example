# ===== API GATEWAY =====
API_GATEWAY_PORT=8000
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ===== AUTH SERVICE =====
AUTH_SERVICE_PORT=8001
AUTH_DB_URL=postgresql://user:password@auth-db:5432/auth_db

# ===== USER SERVICE =====
USER_SERVICE_PORT=8004
USER_DB_URL=postgresql://user:password@user-db:5432/user_db

# ===== ASSIGNMENT SERVICE =====
ASSIGNMENT_SERVICE_PORT=8005
ASSIGNMENT_DB_URL=postgresql://user:password@assignment-db:5432/assignment_db

# ===== SUBMISSION SERVICE =====
SUBMISSION_SERVICE_PORT=8002
SUBMISSION_DB_URL=postgresql://user:password@submission-db:5432/submission_db

# ===== EXECUTION SERVICE =====
EXECUTION_SERVICE_PORT=8003
EXECUTION_DB_URL=postgresql://user:password@execution-db:5432/execution_db

# ===== GRADING SERVICE =====
GRADING_SERVICE_PORT=8006
GRADING_DB_URL=postgresql://user:password@grading-db:5432/grading_db

# ===== PLAGIARISM SERVICE =====
PLAGIARISM_SERVICE_PORT=8009
PLAGIARISM_DB_URL=postgresql://user:password@plagiarism-db:5432/plagiarism_db

# ===== AUDIT SERVICE =====
AUDIT_SERVICE_PORT=8007
AUDIT_DB_URL=postgresql://user:password@audit-db:5432/audit_db

# ===== LMS INTEGRATION SERVICE =====
LMS_SERVICE_PORT=8008
LMS_DB_URL=postgresql://user:password@lms-integration-db:5432/lms_integration_db
LMS_BASE_URL=https://lms.example.com
LMS_API_KEY=your-lms-api-key
LMS_SECRET=your-lms-secret

# ===== MESSAGE BROKER =====
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ===== CACHE =====
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== ENVIRONMENT =====
ENVIRONMENT=development
DEBUG=true

# ============ JWT AUTHENTICATION ============
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-make-it-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ RABBITMQ ============
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ============ REDIS ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ============ SERVICES URLS ============
AUTH_SERVICE_URL=http://localhost:8001
USER_SERVICE_URL=http://localhost:8002
ASSIGNMENT_SERVICE_URL=http://localhost:8003
SUBMISSION_SERVICE_URL=http://localhost:8004
EXECUTION_SERVICE_URL=http://localhost:8005
GRADING_SERVICE_URL=http://localhost:8006
PLAGIARISM_SERVICE_URL=http://localhost:8007
AUDIT_SERVICE_URL=http://localhost:8008
LMS_SERVICE_URL=http://localhost:8009
API_GATEWAY_URL=http://localhost:8000

# ============ EXECUTION SERVICE CONFIG ============
EXECUTION_TIMEOUT_SECONDS=30
SANDBOX_ENABLED=true
MAX_CODE_SIZE_MB=10
SUPPORTED_LANGUAGES=python,java,cpp,javascript,csharp

# ============ GRADING CONFIG ============
DEFAULT_MAX_SCORE=100.0
TEST_CASE_WEIGHT=0.6
CODE_QUALITY_WEIGHT=0.2
EFFICIENCY_WEIGHT=0.2

# ============ PLAGIARISM CONFIG ============
PLAGIARISM_THRESHOLD=0.75
SIMILARITY_ALGORITHM=token_based
MIN_CODE_LENGTH_TO_CHECK=50

# ============ CORS CONFIG ============
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ============ FRONTEND CONFIG ============
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENVIRONMENT=development
REACT_APP_LOG_LEVEL=debug

# ============ EMAIL CONFIG (Optional) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@codigo-evaluacion.com

# ============ LOGGING ============
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============ SECURITY ============
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# ============ RATE LIMITING ============
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# ============ FILE UPLOAD ============
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=.py,.java,.cpp,.js,.cs,.txt
UPLOAD_DIRECTORY=/tmp/uploads

# ============ PRODUCTION SECRETS ============
# ⚠️ CAMBIAR ESTOS EN PRODUCCIÓN ⚠️
API_KEY_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-in-production-32-chars-minimum

# ============ SENTRY (Error tracking - Optional) ============
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============ ANALYTICS (Optional) ============
GA_TRACKING_ID=
MIXPANEL_TOKEN=

# ============ FEATURE FLAGS (Optional) ============
FEATURE_PLAGIARISM_CHECK=true
FEATURE_CODE_REVIEW=false
FEATURE_PEER_REVIEW=false
FEATURE_EXPORT_RESULTS=false
