# API Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Auth Service
AUTH_SERVICE_PORT=8001
AUTH_DB_URL=postgresql://user:password@auth-db:5432/auth_db
AUTH_JWT_SECRET=your-super-secret-jwt-key-change-in-production
AUTH_JWT_ALGORITHM=HS256
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# User Service
USER_SERVICE_PORT=8002
USER_DB_URL=postgresql://user:password@user-db:5432/user_db

# Assignment Service
ASSIGNMENT_SERVICE_PORT=8003
ASSIGNMENT_DB_URL=postgresql://user:password@assignment-db:5432/assignment_db

# Submission Service
SUBMISSION_SERVICE_PORT=8004
SUBMISSION_DB_URL=postgresql://user:password@submission-db:5432/submission_db

# Execution Service
EXECUTION_SERVICE_PORT=8005
EXECUTION_DB_URL=postgresql://user:password@execution-db:5432/execution_db
EXECUTION_SANDBOX_ENABLED=true
EXECUTION_TIMEOUT=30

# Grading Service
GRADING_SERVICE_PORT=8006
GRADING_DB_URL=postgresql://user:password@grading-db:5432/grading_db

# Plagiarism Service
PLAGIARISM_SERVICE_PORT=8007
PLAGIARISM_DB_URL=postgresql://user:password@plagiarism-db:5432/plagiarism_db
PLAGIARISM_THRESHOLD=0.75

# Audit Service
AUDIT_SERVICE_PORT=8008
AUDIT_DB_URL=postgresql://user:password@audit-db:5432/audit_db

# LMS Integration Service
LMS_INTEGRATION_SERVICE_PORT=8009
LMS_INTEGRATION_DB_URL=postgresql://user:password@lms-integration-db:5432/lms_integration_db

# RabbitMQ / Event Broker
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=INFO
